{
  "name": "proof-of-life",
  "version": "1.0.0",
  "description": "A weekly report of what your Claude Code agents did, by type of work. Every run hatches a creature: a signed, tamper-evident record of that run.",
  "license": "MIT",
  "author": "Muhtasim Jadoon",
  "main": "server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server.js",
    "install-hooks": "node install.mjs",
    "uninstall-hooks": "node install.mjs --uninstall",
    "stats": "node scripts/stats.mjs",
    "metrics": "node scripts/metrics.mjs",
    "test": "node scripts/metrics.test.mjs && node collector/test.mjs"
  },  "keywords": ["claude-code", "hooks", "ai-agents", "tamagotchi", "agent-report"]
}
